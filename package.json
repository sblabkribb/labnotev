{
  "name": "labnotev",
  "displayName": "Lab Note Editor",
  "description": "Markdown-based lab note editor with sample tracking and workflow management",
  "version": "0.14.2",
  "publisher": "labnotev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "labnotev.editor",
        "displayName": "Lab Note Editor (BlockNote)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labnotev-samples",
          "title": "Lab Samples",
          "icon": "resources/icons/flask.svg"
        }
      ]
    },
    "views": {
      "labnotev-samples": [
        {
          "id": "labnotev.sampleTreeView",
          "name": "Samples",
          "when": "labnotev.sampleTrackingEnabled"
        }
      ]
    },
    "commands": [
      {
        "command": "labnotev.createLabnote",
        "title": "Lab Note: Create New Labnote Folder"
      },
      {
        "command": "labnotev.insertDate",
        "title": "Lab Note: Insert Current Date"
      },
      {
        "command": "labnotev.insertDateTime",
        "title": "Lab Note: Insert Current Date and Time"
      },
      {
        "command": "labnotev.updateDateField",
        "title": "Lab Note: Update Date Field on Current Line"
      },
      {
        "command": "labnotev.updateAllDateFields",
        "title": "Lab Note: Update All last_updated_date Fields"
      },
      {
        "command": "labnotev.showSampleInfo",
        "title": "Lab Note: Show Sample Info Panel"
      },
      {
        "command": "labnotev.addWorkflow",
        "title": "Lab Note: Add Workflow"
      },
      {
        "command": "labnotev.addUnitOperation",
        "title": "Lab Note: Add Unit Operation"
      },
      {
        "command": "labnotev.refreshSampleTree",
        "title": "Lab Note: Refresh Sample Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "labnotev.insertSampleToEditor",
        "title": "Insert to Editor"
      },
      {
        "command": "labnotev.addSample",
        "title": "Add Sample",
        "icon": "$(add)"
      },
      {
        "command": "labnotev.deleteSample",
        "title": "Delete Sample",
        "icon": "$(trash)"
      },
      {
        "command": "labnotev.editSample",
        "title": "Edit Sample",
        "icon": "$(edit)"
      },
      {
        "command": "labnotev.searchSample",
        "title": "Lab Note: Search Sample",
        "icon": "$(search)"
      },
      {
        "command": "labnotev.openInTextMode",
        "title": "Edit in Text Mode"
      },
      {
        "command": "labnotev.openInBlocknoteMode",
        "title": "Edit in BlockNote Mode"
      },
      {
        "command": "labnotev.openImagePreview",
        "title": "Lab Note: Open Image Preview"
      },
      {
        "command": "labnotev.manageTemplates",
        "title": "Lab Note: Manage Templates"
      },
      {
        "command": "labnotev.reorderWorkflows",
        "title": "Lab Note: Reorder Workflows"
      },
      {
        "command": "labnotev.reorderLabnotes",
        "title": "Lab Note: Reorder Labnotes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "labnotev.searchSample",
          "when": "view == labnotev.sampleTreeView",
          "group": "navigation@1"
        },
        {
          "command": "labnotev.refreshSampleTree",
          "when": "view == labnotev.sampleTreeView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "labnotev.insertSampleToEditor",
          "when": "view == labnotev.sampleTreeView && viewItem == sample",
          "group": "inline"
        },
        {
          "command": "labnotev.addSample",
          "when": "view == labnotev.sampleTreeView && viewItem == type",
          "group": "1_modify"
        },
        {
          "command": "labnotev.editSample",
          "when": "view == labnotev.sampleTreeView && viewItem == sample",
          "group": "1_modify"
        },
        {
          "command": "labnotev.deleteSample",
          "when": "view == labnotev.sampleTreeView && viewItem == sample",
          "group": "2_delete"
        }
      ],
      "editor/context": [
        {
          "command": "labnotev.openInBlocknoteMode",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Lab Note Editor",
      "properties": {
        "labnotev.sampleTracking": {
          "type": "boolean",
          "default": true,
          "description": "Enable Sample TreeView in Activity Bar"
        },
        "labnotev.mongoUrl": {
          "type": "string",
          "default": "",
          "description": "MongoDB connection URL for SBLIMS (format: mongodb://username:password@host:port/?authMechanism=SCRAM-SHA-256&authSource=SBLIMS)",
          "order": 10
        },
        "labnotev.mongoDbName": {
          "type": "string",
          "default": "SBLIMS",
          "description": "MongoDB database name",
          "order": 11
        }
      }
    },
    "keybindings": [
      {
        "command": "labnotev.insertDateTime",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "labnotev.updateDateField",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production && npm run build:webview",
    "build:extension": "node esbuild.js --production",
    "build:webview": "cd webview && npm run build",
    "watch": "node esbuild.js --watch",
    "dev": "concurrently \"npm run watch\" \"cd webview && npm run dev\"",
    "install:all": "npm install && cd webview && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm test && cd webview && npm test"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "mongodb": "^7.0.0"
  }
}
