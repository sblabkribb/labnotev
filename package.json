{
  "name": "labnotev",
  "displayName": "Lab Note Editor",
  "description": "Notion-style block editor for lab notes using BlockNote",
  "version": "0.6.0",
  "publisher": "labnotev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "labnotev.editor",
        "displayName": "Lab Note Editor",
        "selector": [
          {
            "filenamePattern": "*.labnote.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "labnotev.newNote",
        "title": "Lab Note: New Note"
      },
      {
        "command": "labnotev.createLabnote",
        "title": "Lab Note: Create New Labnote Folder"
      },
      {
        "command": "labnotev.insertDate",
        "title": "Lab Note: Insert Current Date"
      },
      {
        "command": "labnotev.insertDateTime",
        "title": "Lab Note: Insert Current Date and Time"
      },
      {
        "command": "labnotev.updateDateField",
        "title": "Lab Note: Update Date Field on Current Line"
      },
      {
        "command": "labnotev.updateAllDateFields",
        "title": "Lab Note: Update All last_updated_date Fields"
      },
      {
        "command": "labnotev.showSampleInfo",
        "title": "Lab Note: Show Sample Info Panel"
      }
    ],
    "keybindings": [
      {
        "command": "labnotev.insertDateTime",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "labnotev.updateDateField",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production && npm run build:webview",
    "build:extension": "node esbuild.js --production",
    "build:webview": "cd webview && npm run build",
    "watch": "node esbuild.js --watch",
    "dev": "concurrently \"npm run watch\" \"cd webview && npm run dev\"",
    "install:all": "npm install && cd webview && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm test && cd webview && npm test"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.8",
    "typescript": "^5.3.2",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
