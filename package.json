{
  "name": "labnotev",
  "displayName": "Labnote Assistant",
  "description": "Markdown-based lab notebook with sample tracking, workflow checklists, and a structured Section Editor for biology and bioinformatics experiments.",
  "version": "0.73.0",
  "license": "MIT",
  "publisher": "korea-biofoundry",
  "icon": "resources/icons/labnotev-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sblabkribb/labnotev.git"
  },
  "homepage": "https://github.com/sblabkribb/labnotev#readme",
  "bugs": {
    "url": "https://github.com/sblabkribb/labnotev/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Notebooks",
    "Education",
    "Other"
  ],
  "keywords": [
    "labnote",
    "lab notebook",
    "experiment",
    "biology",
    "bioinformatics",
    "markdown",
    "sample tracking",
    "workflow",
    "kribb"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/*.labnote.md",
    "onCustomEditor:labnotev.sectionEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "markdown.preview.breaks": true
    },
    "customEditors": [
      {
        "viewType": "labnotev.sectionEditor",
        "displayName": "Lab Note Section Editor",
        "selector": [
          {
            "filenamePattern": "*.labnote.md"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".labnote.md"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labnotev-samples",
          "title": "Lab Samples",
          "icon": "resources/icons/flask.svg"
        }
      ]
    },
    "views": {
      "labnotev-samples": [
        {
          "id": "labnotev.sampleTreeView",
          "name": "Samples",
          "when": "labnotev.sampleTrackingEnabled"
        },
        {
          "id": "labnotev.workflowTreeView",
          "name": "Workflows"
        }
      ]
    },
    "commands": [
      {
        "command": "labnotev.createLabnote",
        "title": "%labnotev.cmd.createLabnote.title%"
      },
      {
        "command": "labnotev.insertDate",
        "title": "%labnotev.cmd.insertDate.title%"
      },
      {
        "command": "labnotev.insertDateTime",
        "title": "%labnotev.cmd.insertDateTime.title%"
      },
      {
        "command": "labnotev.updateDateField",
        "title": "%labnotev.cmd.updateDateField.title%"
      },
      {
        "command": "labnotev.updateAllDateFields",
        "title": "%labnotev.cmd.updateAllDateFields.title%"
      },
      {
        "command": "labnotev.addWorkflow",
        "title": "%labnotev.cmd.addWorkflow.title%"
      },
      {
        "command": "labnotev.addUnitOperation",
        "title": "%labnotev.cmd.addUnitOperation.title%"
      },
      {
        "command": "labnotev.refreshSampleTree",
        "title": "%labnotev.cmd.refreshSampleTree.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "labnotev.insertSampleToEditor",
        "title": "%labnotev.cmd.insertSampleToEditor.title%"
      },
      {
        "command": "labnotev.insertSampleDefinition",
        "title": "%labnotev.cmd.insertSampleDefinition.title%",
        "icon": "$(symbol-constant)"
      },
      {
        "command": "labnotev.addSample",
        "title": "%labnotev.cmd.addSample.title%",
        "icon": "$(add)"
      },
      {
        "command": "labnotev.deleteSample",
        "title": "%labnotev.cmd.deleteSample.title%",
        "icon": "$(trash)"
      },
      {
        "command": "labnotev.deleteCustomType",
        "title": "%labnotev.cmd.deleteCustomType.title%",
        "icon": "$(trash)"
      },
      {
        "command": "labnotev.editSample",
        "title": "%labnotev.cmd.editSample.title%",
        "icon": "$(edit)"
      },
      {
        "command": "labnotev.moveToDefinition",
        "title": "%labnotev.cmd.moveToDefinition.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "labnotev.searchSample",
        "title": "%labnotev.cmd.searchSample.title%",
        "icon": "$(search)"
      },
      {
        "command": "labnotev.openImagePreview",
        "title": "%labnotev.cmd.openImagePreview.title%"
      },
      {
        "command": "labnotev.manageTemplates",
        "title": "%labnotev.cmd.manageTemplates.title%"
      },
      {
        "command": "labnotev.refreshWorkflowTree",
        "title": "%labnotev.cmd.refreshWorkflowTree.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "labnotev.searchWorkflow",
        "title": "%labnotev.cmd.searchWorkflow.title%",
        "icon": "$(search)"
      },
      {
        "command": "labnotev.createWorkflowFromTree",
        "title": "%labnotev.cmd.createWorkflowFromTree.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "labnotev.renameWorkflow",
        "title": "%labnotev.cmd.renameWorkflow.title%"
      },
      {
        "command": "labnotev.renumberWorkflows",
        "title": "%labnotev.cmd.renumberWorkflows.title%"
      },
      {
        "command": "labnotev.deleteWorkflow",
        "title": "%labnotev.cmd.deleteWorkflow.title%",
        "icon": "$(trash)"
      },
      {
        "command": "labnotev.addWorkflowItem",
        "title": "%labnotev.cmd.addWorkflowItem.title%",
        "icon": "$(add)"
      },
      {
        "command": "labnotev.insertUnitOperation",
        "title": "%labnotev.cmd.insertUnitOperation.title%",
        "icon": "$(insert)"
      },
      {
        "command": "labnotev.addUnitOperationItem",
        "title": "%labnotev.cmd.addUnitOperationItem.title%",
        "icon": "$(add)"
      },
      {
        "command": "labnotev.moveSampleToGlobal",
        "title": "%labnotev.cmd.moveSampleToGlobal.title%",
        "icon": "$(globe)"
      },
      {
        "command": "labnotev.moveSampleToLocal",
        "title": "%labnotev.cmd.moveSampleToLocal.title%",
        "icon": "$(folder)"
      },
      {
        "command": "labnotev.openWithSectionEditor",
        "title": "%labnotev.cmd.openWithSectionEditor.title%",
        "icon": {
          "light": "resources/icons/flask-light.svg",
          "dark": "resources/icons/flask-dark.svg"
        }
      },
      {
        "command": "labnotev.openAsTextEditor",
        "title": "%labnotev.cmd.openAsTextEditor.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "labnotev.openPreview",
        "title": "%labnotev.cmd.openPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "labnotev.exportPdf",
        "title": "%labnotev.cmd.exportPdf.title%"
      },
      {
        "command": "labnotev.exportTablesCsv",
        "title": "%labnotev.cmd.exportTablesCsv.title%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "labnotev.openWithSectionEditor",
          "when": "resourceFilename =~ /\\.labnote\\.md$/ && activeCustomEditorId != labnotev.sectionEditor",
          "group": "navigation"
        },
        {
          "command": "labnotev.openAsTextEditor",
          "when": "resourceFilename =~ /\\.labnote\\.md$/ && activeCustomEditorId == labnotev.sectionEditor",
          "group": "navigation"
        },
        {
          "command": "labnotev.openPreview",
          "when": "resourceFilename =~ /\\.labnote\\.md$/ && activeCustomEditorId == labnotev.sectionEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "labnotev.searchSample",
          "when": "view == labnotev.sampleTreeView",
          "group": "navigation@1"
        },
        {
          "command": "labnotev.refreshSampleTree",
          "when": "view == labnotev.sampleTreeView",
          "group": "navigation@2"
        },
        {
          "command": "labnotev.searchWorkflow",
          "when": "view == labnotev.workflowTreeView",
          "group": "navigation@1"
        },
        {
          "command": "labnotev.refreshWorkflowTree",
          "when": "view == labnotev.workflowTreeView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "labnotev.insertSampleToEditor",
          "when": "view == labnotev.sampleTreeView && viewItem =~ /^sample_/",
          "group": "inline"
        },
        {
          "command": "labnotev.addSample",
          "when": "view == labnotev.sampleTreeView && viewItem =~ /^type(_custom)?$/",
          "group": "1_modify"
        },
        {
          "command": "labnotev.deleteCustomType",
          "when": "view == labnotev.sampleTreeView && viewItem == type_custom",
          "group": "2_delete"
        },
        {
          "command": "labnotev.editSample",
          "when": "view == labnotev.sampleTreeView && viewItem =~ /^sample_/",
          "group": "1_modify@2"
        },
        {
          "command": "labnotev.moveToDefinition",
          "when": "view == labnotev.sampleTreeView && viewItem =~ /^sample_/",
          "group": "1_modify@3"
        },
        {
          "command": "labnotev.deleteSample",
          "when": "view == labnotev.sampleTreeView && viewItem =~ /^sample_/",
          "group": "2_delete"
        },
        {
          "command": "labnotev.moveSampleToGlobal",
          "when": "view == labnotev.sampleTreeView && viewItem == sample_local",
          "group": "3_move"
        },
        {
          "command": "labnotev.moveSampleToLocal",
          "when": "view == labnotev.sampleTreeView && viewItem == sample_global",
          "group": "3_move"
        },
        {
          "command": "labnotev.createWorkflowFromTree",
          "when": "view == labnotev.workflowTreeView && viewItem == workflow",
          "group": "inline"
        },
        {
          "command": "labnotev.addWorkflowItem",
          "when": "view == labnotev.workflowTreeView && viewItem == category",
          "group": "1_modify"
        },
        {
          "command": "labnotev.insertUnitOperation",
          "when": "view == labnotev.workflowTreeView && viewItem == unitOperation",
          "group": "inline"
        },
        {
          "command": "labnotev.addUnitOperationItem",
          "when": "view == labnotev.workflowTreeView && viewItem == unitOpRoot",
          "group": "1_modify"
        }
      ],
      "explorer/context": [
        {
          "command": "labnotev.renameWorkflow",
          "when": "resourceFilename =~ /^\\d{3}_.+\\.labnote\\.md$/",
          "group": "7_modification"
        },
        {
          "command": "labnotev.renumberWorkflows",
          "when": "resourceFilename =~ /^README\\.labnote\\.md$/i",
          "group": "7_modification"
        },
        {
          "command": "labnotev.deleteWorkflow",
          "when": "resourceFilename =~ /^\\d{3}_.+\\.labnote\\.md$/",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "Lab Note Editor",
      "properties": {
        "labnotev.sampleTracking": {
          "type": "boolean",
          "default": true,
          "description": "Enable Sample TreeView in Activity Bar"
        },
        "labnotev.customSampleTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom sample types in addition to built-in types (DNA, RNA, Plasmid, etc.)"
        }
      }
    },
    "keybindings": [
      {
        "command": "labnotev.insertDateTime",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "labnotev.updateDateField",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ]
  },
  "workspaces": [
    "packages/*",
    "webview-section"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production && npm run build:webview",
    "build:extension": "node esbuild.js --production",
    "build:webview": "npm run build -w labnotev-section-editor",
    "build:obsidian": "npm run build -w @labnotev/obsidian-plugin",
    "build:all": "npm run build && npm run build:obsidian",
    "watch": "node esbuild.js --watch",
    "dev": "npm run watch",
    "install:all": "npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm test && npm run test -w labnotev-section-editor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:webview": "npm run typecheck -w labnotev-section-editor",
    "typecheck:obsidian": "npm run typecheck -w @labnotev/obsidian-plugin",
    "typecheck:all": "npm run typecheck && npm run typecheck:core && npm run typecheck:webview && npm run typecheck:obsidian",
    "sync:versions": "node scripts/syncVersions.mjs",
    "lint": "eslint .",
    "lint:webview": "npm run lint -w labnotev-section-editor",
    "lint:all": "npm run lint && npm run lint:webview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.2",
    "eslint": "^10.4.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.0.18"
  }
}
